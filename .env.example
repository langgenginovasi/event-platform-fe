# URL backend API. Untuk deployment Docker/Dokploy wajib dilewatkan sebagai
# BUILD ARG (bukan runtime env), karena NEXT_PUBLIC_* di-inline oleh Next.js
# saat proses build. Contoh:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.domain.com/api .
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Secret untuk NextAuth (JWT signing). WAJIB diganti di production.
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"

# URL publik aplikasi frontend.
NEXTAUTH_URL="http://localhost:3000"
