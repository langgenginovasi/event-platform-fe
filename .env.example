# ──────────────────────────────────────────────────────────────────────────────
# Event Platform FE — Next.js Frontend
# Template / referensi utama untuk .env (local) dan .env.production.
# Copy file ini lalu isi nilai sesuai environment:
#   local      : cp .env.example .env
#   production : cp .env.example .env.production
# JANGAN pernah commit .env / .env.production (sudah di .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ─── Backend API ──────────────────────────────────────────────────────────────
# Base URL backend event-platform-be (TANPA trailing slash; path "/api" sudah
# di-kode di src/lib/api.ts). Untuk deployment Docker/Dokploy WAJIB dilewatkan
# sebagai BUILD ARG (bukan runtime env), karena NEXT_PUBLIC_* di-inline oleh
# Next.js saat proses build. Contoh:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.domain.com/api .
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Secret untuk NextAuth (JWT signing). WAJIB diganti di production dengan
# string acak panjang. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"

# URL publik aplikasi frontend (TANPA trailing slash). Untuk production berisi
# domain publik, mis. https://eventhipmi.elevatelabs.tech
NEXTAUTH_URL="http://localhost:3000"
